version: '3.8'

services:
  # n8n - Workflow Automation
  n8n:
    image: n8nio/n8n:latest
    container_name: canton-n8n
    restart: always
    ports:
      - "5678:5678"
    environment:
      - N8N_BASIC_AUTH_ACTIVE=true
      - N8N_BASIC_AUTH_USER=admin
      - N8N_BASIC_AUTH_PASSWORD=Summan4482749#
      - N8N_ENCRYPTION_KEY=your_32_char_encryption_key_here
      - N8N_HOST=your-domain.com
      - N8N_PORT=5678
      - N8N_PROTOCOL=https
      - WEBHOOK_URL=https://your-domain.com/
      - N8N_METRICS=true
      - N8N_METRICS_INCLUDE_DEFAULT_METRICS=true
      - EXECUTIONS_DATA_PRUNE=true
      - EXECUTIONS_DATA_MAX_AGE=168
    volumes:
      - ~/.n8n:/home/node/.n8n
      - ./scripts:/scripts
      - ./temp:/temp
      - ./templates:/templates
      - ./logs:/logs
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - canton-network

  # Optional: PostgreSQL for n8n (production)
  postgres:
    image: postgres:15
    container_name: canton-postgres
    restart: always
    environment:
      - POSTGRES_USER=n8n
      - POSTGRES_PASSWORD=your_db_password_here
      - POSTGRES_DB=n8n
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
      - canton-network
    ports:
      - "5432:5432"

  # Optional: Cloudflare Tunnel
  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: canton-cloudflared
    restart: always
    command: tunnel --no-autoupdate run --token $${CLOUDFLARE_TUNNEL_TOKEN}
    environment:
      - CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiNGNiYTkxNTY0MDIwYjFjMWVkNTM5YmI4ZWFhN2YyZWMiLCJ0IjoiZmI3ZjUwNTItZTAzYS00ZmViLTlkODUtZTMxMDQ4YjJkNTM4IiwicyI6IlpqUmtZelF5TkdVdFpHTTVOQzAwTWpBekxUa3labVl0Wmpkak9UVmxNRGN6TVRneVpESmpZV1E1Tm1FdFlUVTJNQzAwWkdNNExUZzNZelF0TmpFM1lqSmpPRFZrTnpRMCJ9

    networks:
      - canton-network

networks:
  canton-network:
idge

volumes:
  postgres-data:
